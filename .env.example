# FitNesse MCP Server – environment configuration
# Copy this file and adjust values before running the server.

FITNESSE_BASE_URL=http://localhost:8080

# Basic auth – leave blank to disable.
FITNESSE_USERNAME=
FITNESSE_PASSWORD=

# Response/file transfer size caps (bytes).
FITNESSE_MAX_RESPONSE_BYTES=1048576
FITNESSE_FILES_MAX_TRANSFER_BYTES=10485760

# Resource root of the files section on THIS FitNesse instance (no leading
# slash; typically "files", but some instances configure a different root).
# Required to enable fitnesse_list_files, fitnesse_create_dir,
# fitnesse_upload_file, fitnesse_download_file, and fitnesse_delete_file;
# leave blank to disable them. Neither tool touches local disk: content
# travels through the tool call itself (fitnesse_upload_file takes it as an
# argument, fitnesse_download_file returns it directly in the result).
FITNESSE_FILES_ROOT=files

# Feature flags – set to 1 to enable.
FITNESSE_ALLOW_SHUTDOWN=0
FITNESSE_READONLY=1
