# FitNesse MCP Server – environment configuration
# Copy this file and adjust values before running the server.

FITNESSE_BASE_URL=http://localhost:8080

# Basic auth – leave blank to disable.
FITNESSE_USERNAME=
FITNESSE_PASSWORD=

# Response/upload size caps (bytes).
FITNESSE_MAX_RESPONSE_BYTES=1048576
FITNESSE_MAX_UPLOAD_BYTES=10485760

# Absolute path on the host that the server may read files from for uploads
# and write files to for downloads. Required to enable the fitnesse_list_files,
# fitnesse_upload_file, and fitnesse_download_file tools; leave blank to disable them.
FITNESSE_FILES_ROOT=

# Feature flags – set to 1 to enable.
FITNESSE_ALLOW_SHUTDOWN=0
FITNESSE_READONLY=1
