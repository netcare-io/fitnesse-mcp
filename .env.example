# FitNesse MCP Server – environment configuration
# Copy this file and adjust values before running the server.

# Default instance. Over HTTP a request may name another one in the X-FitNesse-Url header
# (not checked: see Security in the README).
FITNESSE_BASE_URL=http://localhost:8080

# Whose FitNesse login a call uses. env: FITNESSE_USERNAME/FITNESSE_PASSWORD below.
# headers: every HTTP request sends its own in X-FitNesse-Username / X-FitNesse-Password
# (HTTP transport only; serve it over HTTPS).
FITNESSE_AUTH_MODE=env

# Basic auth (env mode) – leave blank to disable.
FITNESSE_USERNAME=
FITNESSE_PASSWORD=

# Response/file transfer size caps (bytes).
FITNESSE_MAX_RESPONSE_BYTES=1048576
FITNESSE_FILES_MAX_TRANSFER_BYTES=10485760

# Resource root of the files section on THIS FitNesse instance (no leading
# slash; typically "files", but some instances configure a different root).
# Required to enable fitnesse_list_files, fitnesse_create_dir,
# fitnesse_upload_file, fitnesse_download_file, fitnesse_delete_file, and
# fitnesse_rename_file; leave blank to disable them. Neither upload nor
# download touches local disk: content travels through the tool call itself
# (fitnesse_upload_file takes it as an argument, fitnesse_download_file
# returns it directly in the result).
FITNESSE_FILES_ROOT=files

# Read timeout (seconds) for fitnesse_run_test / fitnesse_run_suite; 0 disables it.
FITNESSE_RUN_TIMEOUT_SECONDS=120

# Toolsets, comma-separated. Modes read, write, test (FitNesse's
# secure-read/-write/-test) filter every tool; areas debug (KDTA debug tools) and
# complete (16 lower-traffic tools, marked in the README) add tools within those
# modes. "all" = read,write,test (no area); "all,debug,complete" = everything.
# debug needs netcare's FitNesse fork (debugTest/debugTable).
# Required; read is recommended for a first run.
FITNESSE_TOOLSETS=read

# Feature flags – set to 1 to enable.
# fitnesse_shutdown: stops the FitNesse server.
FITNESSE_ALLOW_SHUTDOWN=0
# fitnesse_save_account: change passwords, create/delete users.
FITNESSE_ALLOW_ACCOUNT_ADMIN=0
# fitnesse_debug_status(adopt=true): take over debug sessions this server did not start
# (maybe a person's in the browser). Leave off when the server has its own FitNesse account.
FITNESSE_ALLOW_ADOPT=0

# KDTA debug tuning (only with debug in FITNESSE_TOOLSETS).
FITNESSE_DEBUG_TIMEOUT_SECONDS=660
FITNESSE_DEBUG_MAX_RESPONSE_BYTES=16777216
FITNESSE_DEBUG_MAX_CELL_CHARS=1500
