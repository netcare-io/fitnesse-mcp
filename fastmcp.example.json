{
    "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
    "source": {
        "path": "server.py",
        "entrypoint": "mcp"
    },
    "deployment": {
        "env": {
            "FITNESSE_BASE_URL": "http://localhost:8080",
            "FITNESSE_USERNAME": "",
            "FITNESSE_PASSWORD": "",
            "FITNESSE_MAX_RESPONSE_BYTES": "1048576",
            "FITNESSE_FILES_MAX_TRANSFER_BYTES": "10485760",
            "FITNESSE_ALLOW_SHUTDOWN": "0",
            "FITNESSE_READONLY": "1",
            "FITNESSE_COMPLETE_TOOLSET": "0"
        }
    }
}
